# Server
PORT=3000

# Ephemeral TTLs (milliseconds) — everything is in-memory; these control burn time
MSG_TTL_MS=300000
STORY_TTL_MS=1800000
POST_TTL_MS=900000
ROOM_IDLE_MS=3600000

# Tenor GIF search (optional — demo key works for light use)
# Get a key: https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=LIVDSRZULELA

# TURN (optional but recommended for calls behind strict NAT)
# Free tiers: Metered.ca, Twilio STUN/TURN, Cloudflare Calls
# Public STUN is always enabled (Google + Cloudflare).
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=your-turn-user
TURN_CREDENTIAL=your-turn-password

# Multiple TURN URLs: comma-separated
# TURN_URL=turn:host:3478,turns:host:5349
